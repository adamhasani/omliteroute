# ==============================================================================
# 🪶 OmliteRoute — Ultra-Lightweight Container Image
# ==============================================================================

FROM node:22-bookworm-slim AS runner

WORKDIR /app

ENV NODE_ENV=production \
    OMNIROUTE_LITE=1 \
    OMNIROUTE_DISABLE_BACKGROUND_SERVICES=1 \
    OMNIROUTE_MEMORY_MB=512 \
    PORT=20128 \
    HOSTNAME=0.0.0.0

# Install omliteroute globally from npm registry
RUN npm install -g omliteroute@latest --omit=dev --no-audit --no-fund && \
    rm -rf /root/.npm /tmp/*

# Persistent volume for SQLite data & configurations
VOLUME ["/root/.omniroute"]

EXPOSE 20128

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:20128/api/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["omliteroute", "serve", "--port", "20128", "--no-open"]
